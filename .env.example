# Copy to .env.local (Next.js and `pnpm lesson` both read it).
# With DATABASE_URL set, the todos feature uses Postgres (start it with `pnpm db:up`).
# Remove or comment it out to use the in-memory repository instead. No code change: it's a Layer swap.
DATABASE_URL=postgres://effect:effect@localhost:5432/todos

# How often the scheduled cleanup job deletes completed todos (any Effect Duration string).
# TODO_CLEANUP_INTERVAL=2 minutes
