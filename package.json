{
  "name": "learn-effect-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "telemetry:up": "docker compose up -d lgtm",
    "telemetry:down": "docker compose stop lgtm",
    "dev:otel": "OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 next dev",
    "lesson": "tsx src/lessons/run.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:reset": "docker compose rm -sfv postgres && docker volume rm -f learn-effect-library_pg-data && docker compose up -d --wait postgres",
    "db:psql": "docker compose exec postgres psql -U effect -d todos",
    "infra:down": "docker compose down",
    "test:db": "DATABASE_URL=postgres://effect:effect@localhost:5432/todos vitest run"
  },
  "dependencies": {
    "@effect/atom-react": "^4.1.1",
    "@effect/sql-pg": "^4.1.1",
    "effect": "^4.1.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
